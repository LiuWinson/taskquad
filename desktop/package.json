{
  "name": "taskquad-desktop",
  "version": "1.1.0",
  "description": "任务四象限 Windows 桌面端（内置局域网同步服务）",
  "author": "taskquad",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.taskquad.desktop",
    "productName": "任务四象限",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../server", "to": "server", "filter": ["**/*", "!data/**"] },
      { "from": "../web/dist", "to": "web/dist" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "任务四象限"
    }
  }
}
